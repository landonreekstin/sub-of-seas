script = ExtResource("1_m")
key = "task_force"
title = "Battle Line"
briefing = "A Kongo-class battleship and a Takao-class heavy cruiser with three destroyers, at 18 knots. Do not surface anywhere near them: their guns outrange anything we have. Sink a capital ship."
