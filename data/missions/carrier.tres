[gd_resource type="Resource" script_class="MissionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/mission_data.gd" id="1_m"]

[resource]
script = ExtResource("1_m")
key = "carrier"
title = "Flattop"
briefing = "A Shokaku-class carrier is making 20 knots for home with two destroyers in the screen. We have one chance as she passes. Get ahead of her track, let her come to you, and sink her."
