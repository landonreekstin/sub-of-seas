[resource]
script = ExtResource("1_m")
key = "titan_cave"
era = "modern"
title = "The Cave"
briefing = "A cave runs right through the rock ridge ahead, out of sight under the water: a tight S-bend, its roof rising and dipping, its floor coming up in places. Take her through and out the far end, as fast as you can. She's small but slow, and the pilot can't see the walls: the crew at the viewport have to talk him through. Every scrape counts against you."
difficulty = 2
