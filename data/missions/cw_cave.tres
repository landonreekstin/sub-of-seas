[resource]
script = ExtResource("1_m")
key = "cw_cave"
era = "cold_war"
title = "The Cave"
briefing = "A cave runs right through the rock ridge ahead, out of sight under the water: a tight S-bend, its roof rising and dipping, its floor coming up in places. Take her through and out the far end, as fast as you can. Helm keeps her in the middle, the planes keep her off the roof and the floor, and someone has to call out what's coming. Every scrape counts against you."
difficulty = 2
