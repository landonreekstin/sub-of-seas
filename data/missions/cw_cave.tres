start_depth = 30.0
start_speed = 0
battery = 1.0
groups = Array[Dictionary]([])
objectives = Array[Dictionary]([{"kind": "cave", "text": "Through the cave and out the other end"}])
sea_state = 0
squalls = 0
cave = true
