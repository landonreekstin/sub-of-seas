#!/usr/bin/env bash
# Run Sub of Seas from this checkout.
#
#   ./play                         the menu
#   ./play host [mission] [sub]    host a patrol (missions: convoy tankers hunted carrier task_force sandbox;
#                                  subs: s_boat gato narwhal)
#   ./play training                host the training patrol
#   ./play join [address]          join a host (default 192.168.1.76, lando's gaming-pc over the VPN)
#   ./play ... -- <extra args>     anything after -- goes to the game (e.g. --name Blaney)
#
# Uses port 7845 like the launcher, so the homelab VPN forward to gaming-pc works when lando
# hosts from source. A source build reports itself as "dev-<commit>", which every host lets in,
# so to play together both of you need the same commit. This script sees to it: on main it
# fast-forwards to origin/main before starting (unless you have uncommitted changes); on any
# other branch it warns when main has moved on, and host/join ask before going on.
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-}" in -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac

PORT=7845
JOIN_ADDRESS=192.168.1.76

if command -v godot >/dev/null 2>&1; then
	GODOT=(godot)
else
	echo "play: godot isn't on PATH; using Godot 4 from nixpkgs (the first run downloads it)." >&2
	GODOT=(nix run nixpkgs/nixos-unstable#godot_4 --)
fi

mode="${1:-menu}"

ask() { # ask "question": yes when there's no terminal to ask on
	[ -t 0 ] || return 0
	local reply; read -r -p "$1 [y/N] " reply; [[ "$reply" == [yY]* ]]
}

# Be on the latest version: both players must run the same commit to play together.
branch="$(git branch --show-current 2>/dev/null || echo '?')"
# Never stop to ask for a GitHub login: no credentials just means no update check.
if GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS= timeout 8 git fetch -q origin main 2>/dev/null; then
	behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
	ahead="$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)"
	if [ "$behind" -gt 0 ] && [ "$branch" = main ]; then
		if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
			echo "play: main is $behind commit(s) behind origin/main, and you have uncommitted changes," >&2
			echo "      so it can't update. Commit or stash them, then run ./play again." >&2
			exit 1
		fi
		echo "play: updating main ($behind new commit(s) from origin/main)..." >&2
		git merge -q --ff-only origin/main || { echo "play: main has diverged from origin/main; sort that out first." >&2; exit 1; }
	elif [ "$behind" -gt 0 ]; then
		echo "play: $branch is $behind commit(s) behind origin/main. Someone on main won't match you." >&2
		case "$mode" in host|join) ask "play: start anyway?" || exit 1 ;; esac
	fi
	if [ "$ahead" -gt 0 ] && [ "$mode" = host ]; then
		echo "play: $branch has $ahead commit(s) that aren't on origin/main; whoever joins won't have them." >&2
	fi
else
	echo "play: couldn't reach GitHub to check for updates; running what you have." >&2
fi
commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
[ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ] && commit="$commit+changes"
echo "play: running $branch ($commit)" >&2

# Re-import when the code changed since the last run: a fresh clone has no imported assets,
# and new class names need the script class cache rebuilt.
stamp=.godot/play-import-stamp
now="$(git rev-parse HEAD 2>/dev/null || echo none) $(git status --porcelain 2>/dev/null | sha1sum | cut -c1-12)"
if [ ! -f "$stamp" ] || [ "$(cat "$stamp")" != "$now" ]; then
	echo "play: importing the project (only after changes)..." >&2
	"${GODOT[@]}" --headless --path . --import >/dev/null 2>&1 || true
	mkdir -p .godot && echo "$now" > "$stamp"
fi


[ $# -gt 0 ] && shift
args=(--port "$PORT" --address "$JOIN_ADDRESS" --build "dev-$commit")
case "$mode" in
	menu) ;;
	host)
		mission="convoy"; sub="gato"
		if [ $# -gt 0 ] && [ "$1" != "--" ]; then mission="$1"; shift; fi
		if [ $# -gt 0 ] && [ "$1" != "--" ]; then sub="$1"; shift; fi
		args+=(--mission "$mission" --sub "$sub") ;;
	training) args+=(--training) ;;
	join)
		address="$JOIN_ADDRESS"
		if [ $# -gt 0 ] && [ "$1" != "--" ]; then address="$1"; shift; fi
		args+=(--join "$address") ;;
	*) echo "play: unknown mode '$mode' (menu, host, training, join)" >&2; exit 2 ;;
esac
[ "${1:-}" = "--" ] && shift
exec "${GODOT[@]}" --path . -- "${args[@]}" "$@"
