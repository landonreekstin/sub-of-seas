#!/usr/bin/env bash
# Run Sub of Seas from this checkout.
#
#   ./play                         the menu
#   ./play host [mission] [sub]    host a patrol (missions: convoy tankers hunted carrier task_force sandbox;
#                                  subs: s_boat gato narwhal)
#   ./play training                host the training patrol
#   ./play join [address]          join a host (default 192.168.1.76, lando's gaming-pc over the VPN)
#   ./play ... -- <extra args>     anything after -- goes to the game (e.g. --name Blaney)
#
# Uses port 7845 like the launcher, so the homelab VPN forward to gaming-pc works when lando
# hosts from source. A source build reports itself as "dev", which every host lets in: to
# play together, both of you run the same commit (this script warns when you're behind main).
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-}" in -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac

PORT=7845
JOIN_ADDRESS=192.168.1.76

if command -v godot >/dev/null 2>&1; then
	GODOT=(godot)
else
	echo "play: godot isn't on PATH; using Godot 4 from nixpkgs (the first run downloads it)." >&2
	GODOT=(nix run nixpkgs/nixos-unstable#godot_4 --)
fi

# Re-import when the code changed since the last run: a fresh clone has no imported assets,
# and new class names need the script class cache rebuilt.
stamp=.godot/play-import-stamp
now="$(git rev-parse HEAD 2>/dev/null || echo none) $(git status --porcelain 2>/dev/null | sha1sum | cut -c1-12)"
if [ ! -f "$stamp" ] || [ "$(cat "$stamp")" != "$now" ]; then
	echo "play: importing the project (only after changes)..." >&2
	"${GODOT[@]}" --headless --path . --import >/dev/null 2>&1 || true
	mkdir -p .godot && echo "$now" > "$stamp"
fi

# Say what is being run, and whether main has moved on.
branch="$(git branch --show-current 2>/dev/null || echo '?')"
if timeout 5 git fetch -q origin main 2>/dev/null; then
	behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
	[ "$behind" -gt 0 ] && echo "play: $branch is $behind commit(s) behind origin/main." >&2
fi
echo "play: running $branch ($(git rev-parse --short HEAD 2>/dev/null))" >&2

mode="${1:-menu}"
[ $# -gt 0 ] && shift
args=(--port "$PORT" --address "$JOIN_ADDRESS")
case "$mode" in
	menu) ;;
	host)
		mission="convoy"; sub="gato"
		if [ $# -gt 0 ] && [ "$1" != "--" ]; then mission="$1"; shift; fi
		if [ $# -gt 0 ] && [ "$1" != "--" ]; then sub="$1"; shift; fi
		args+=(--mission "$mission" --sub "$sub") ;;
	training) args+=(--training) ;;
	join)
		address="$JOIN_ADDRESS"
		if [ $# -gt 0 ] && [ "$1" != "--" ]; then address="$1"; shift; fi
		args+=(--join "$address") ;;
	*) echo "play: unknown mode '$mode' (menu, host, training, join)" >&2; exit 2 ;;
esac
[ "${1:-}" = "--" ] && shift
exec "${GODOT[@]}" --path . -- "${args[@]}" "$@"
